# Frontend Environment Configuration
# ------------------------------------------------------------------
# IMPORTANT: Do NOT put Database passwords or SMTP credentials here.
# The frontend is public code. Only put the API URL here.
# ------------------------------------------------------------------

# Production: The full URL of your deployed backend
# Example: https://mintcom-backend.onrender.com
#
# Local Development: You can leave this empty (defaults to http://localhost:3000)
VITE_API_URL=https://api.mintcompos.com

# Public site URL used for canonical tags and social metadata
VITE_SITE_URL=https://mintcompos.com

# Google OAuth Client ID
# Get this from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Go to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized JavaScript origins:
#    - http://localhost:5173 (for development)
#    - http://localhost:5174 (for this repo's Vite dev server)
#    - https://mintcompos.com (for production)
#    - https://www.mintcompos.com (if you serve the www hostname)
# 5. Copy the Client ID here
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Sign in with Apple (web flow).
# Uses an Apple "Services ID" (NOT the app's bundle ID) plus a registered Return URL.
# These default to the website's values when omitted, so they only need to
# be set if you point the site at a different Apple Service ID.
#  - Service ID must be attached to the primary App ID com.mintcom.website
#  - The website domain must be registered under the Service ID's "Domains and Subdomains"
#  - The Return URL below must be registered verbatim on the Service ID
# Backend must allow both audiences: APPLE_CLIENT_IDS=com.mintcom.website,com.mintcom.website.service
VITE_APPLE_SERVICE_ID=com.mintcom.website.service
VITE_APPLE_REDIRECT_URI=https://api.mintcompos.com/api/accounts/apple-callback

# Xero & QuickBooks OAuth Redirect URI Override (optional).
# Defaults automatically to: ${window.location.origin}${window.location.pathname}
# (e.g. http://localhost:5173/dashboard/my-store/settings).
# If specified, it must match verbatim with the Redirect URI in https://developer.xero.com/app/manage
# VITE_XERO_REDIRECT_URI=http://localhost:5173/dashboard/my-store/settings

# Google Analytics 4 Measurement ID.
# Get it from Google Analytics > Admin > Data streams > Web stream > Measurement ID.
# Example format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Public app-store or verified installer URLs.
# If left blank, the site falls back to https://www.google.com so badges stay clickable.
# Replace with real App Store / Play Store (or beta) URLs when ready.
# Do not use placeholder domains in production because security scanners flag them.
VITE_ANDROID_DOWNLOAD_URL=
VITE_IOS_DOWNLOAD_URL=
VITE_OWNER_ANDROID_DOWNLOAD_URL=
VITE_OWNER_IOS_DOWNLOAD_URL=
VITE_ONBOARDING_VIDEO_URL=

# Public marketing video shown by the landing-page "Watch Video" button.
# Must be an https URL (e.g. a Vimeo/YouTube embed URL). When left blank the
# "Watch Video" button is hidden so it can never open an empty modal.
VITE_HERO_VIDEO_URL=

# Set to true only for local dev when you want the SPA Coming Soon gate.
# Production maintenance is controlled on Cloudflare (Worker MAINTENANCE_MODE
# var + QA_ACCESS_KEY secret) so the bypass key is never shipped in client JS.
VITE_MAINTENANCE_MODE=false

# LOCAL DEV ONLY — optional soft bypass for the SPA maintenance wrapper.
# Production: set the secret on Cloudflare (never commit it):
#   npx wrangler secret put QA_ACCESS_KEY
# Then open https://mintcompos.com/qa-access?key=YOUR_SECRET
# Do NOT put production secrets here; this file is a template only.
VITE_QA_ACCESS_KEY=
